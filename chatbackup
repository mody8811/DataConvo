<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Data Convo.beta</title>
    <link rel="stylesheet" href="{{ url_for('static', filename='style.css') }}">
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Roboto', sans-serif;
            margin: 0;
            padding: 0;
            background-color: #f5f5f5;
            color: #333;
        }

        #chat-container {
            display: flex;
            height: 100vh;
            background-color: #fff;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
        }

        /* Freeze the sidebar */
        #sidebar {
            width: 250px;
            background-color: #2c3e50;
            color: #fff;
            padding: 20px;
            overflow-y: auto;
            position: sticky;
            top: 0;
            height: 100vh; /* Full height */
        }

        #sidebar h2 {
            font-size: 18px;
            margin-bottom: 20px;
        }

        #table-list {
            list-style: none;
            padding: 0;
        }

        #table-list li {
            margin-bottom: 10px;
            cursor: pointer;
            padding: 10px;
            border-radius: 5px;
            transition: background-color 0.3s ease;
        }

        #table-list li:hover {
            background-color: #34495e;
        }

        .columns-list {
            list-style: none;
            padding-left: 20px;
            margin-top: 10px;
            display: none;
        }

        .columns-list li {
            font-size: 14px;
            padding: 5px 0;
        }

        /* Chat area */
        #chat-area {
            flex: 1;
            display: flex;
            flex-direction: column;
            padding: 20px;
            background-color: #f9f9f9;
            overflow: hidden; /* Prevent overflow */
        }

        #chat-title {
            font-size: 24px;
            margin-bottom: 20px;
            color: #2c3e50;
        }

        #chat-display {
            flex: 1;
            overflow-y: auto;
            padding: 10px;
            background-color: #fff;
            border-radius: 10px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.05);
            margin-bottom: 20px;
            display: flex;
            flex-direction: column;
        }

        .message {
            margin-bottom: 15px;
            padding: 10px;
            border-radius: 10px;
            max-width: 70%;
            word-wrap: break-word;
            position: relative;
        }

        .message.User {
            background-color: #e1f5fe;
            align-self: flex-start;
            margin-right: 10px;
        }

        .message.AI {
            background-color: #f1f1f1;
            align-self: flex-start;
            margin-left: 10px;
        }

        .message strong {
            display: block;
            margin-bottom: 5px;
            font-weight: 500;
        }

        .status {
            color: #888;
            font-style: italic;
            text-align: center;
            margin: 10px 0;
            align-self: center;
        }

        #chat-input-container {
            display: flex;
            gap: 10px;
        }

        #chat-input {
            flex: 1;
            padding: 10px;
            border: 1px solid #ddd;
            border-radius: 5px;
            font-size: 16px;
        }

        #chat-input:focus {
            outline: none;
            border-color: #2c3e50;
        }

        button {
            padding: 10px 20px;
            background-color: #2c3e50;
            color: #fff;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-size: 16px;
            transition: background-color 0.3s ease;
        }

        button:hover {
            background-color: #34495e;
        }

        /* Table Styling */
        .table-container {
            max-width: 100%;
            overflow-x: auto;
            margin: 10px 0;
            border: 1px solid #ddd;
            border-radius: 5px;
            position: relative; /* Added for export icon positioning */
        }

        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 14px;
            min-width: 600px; /* Ensure the table has a minimum width */
        }

        table th, table td {
            padding: 8px;
            border: 1px solid #ddd;
            text-align: left;
            white-space: nowrap; /* Prevent text wrapping */
        }

        table th {
            background-color: #f5f5f5;
            font-weight: 500;
        }

        table tr:nth-child(even) {
            background-color: #f9f9f9;
        }

        table tr:hover {
            background-color: #f1f1f1;
        }

        /* Export Icon Styling */
        .share-icon {
            position: absolute;
            top: 10px;
            right: 10px;
            cursor: pointer;
            color: #2c3e50;
            font-size: 14px;
            background-color: #f5f5f5;
            padding: 5px 10px;
            border-radius: 5px;
            border: 1px solid #ddd;
        }

        .share-icon:hover {
            background-color: #e1f5fe;
            color: #007bff;
        }

        /* New styles for the query optimizer modal */
        .modal {
            display: none; /* Hidden by default */
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background-color: white;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
            z-index: 1000;
        }

        .modal-content {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        textarea {
            width: 100%;
            height: 100px;
            padding: 10px;
            border: 1px solid #ddd;
            border-radius: 5px;
            font-family: 'Roboto', sans-serif;
        }

        .query-optimize-icon {
            cursor: pointer;
            color: #2c3e50;
            font-size: 14px;
            margin-left: 10px;
        }

        .query-optimize-icon:hover {
            color: #007bff;
        }

        .insights-button {
            cursor: pointer;
            color: #2c3e50;
            font-size: 14px;
            margin-left: 10px;
            padding: 5px 10px;
            border: 1px solid #ddd;
            border-radius: 5px;
            background-color: #f5f5f5;
        }

        .insights-button:hover {
            background-color: #e1f5fe;
            color: #007bff;
        }
    </style>
</head>
<body>
    <div id="chat-container">
        <!-- Sidebar for Database Tables -->
        <div id="sidebar">
            <h2>Database Tables</h2>
            <ul id="table-list">
                {% for table, columns in schema_info.items() %}
                    <li onclick="toggleColumns('{{ table }}')">{{ table }}
                        <ul id="columns-{{ table }}" class="columns-list">
                            {% for column in columns %}
                                <li>{{ column }}</li>
                            {% endfor %}
                        </ul>
                    </li>
                {% endfor %}
            </ul>
        </div>

        <!-- Chat Area -->
        <div id="chat-area">
            <h1 id="chat-title">Speak to Data.beta</h1>
            <div id="chat-display">
                <!-- Processing message will appear here -->
            </div>
            <div id="chat-input-container">
                <input type="text" id="chat-input" placeholder="Type a message...">
                <button onclick="sendMessage()">Send</button>
                <span class="insights-button" onclick="getInsights()">📊 Get Insights</span>
                <span class="query-optimize-icon" onclick="openQueryOptimizer()">🪄 Optimize Query</span>
            </div>
        </div>
    </div>

    <!-- Query Optimizer Modal -->
    <div id="query-optimizer-modal" class="modal">
        <div class="modal-content">
            <h2>Optimize Your Query</h2>
            <textarea id="query-input" placeholder="Enter your SQL query here..."></textarea>
            <button onclick="optimizeQuery()">Optimize</button>
            <button onclick="closeQueryOptimizer()">Close</button>
        </div>
    </div>

    <script>
        const chatDisplay = document.getElementById('chat-display');
        const chatInput = document.getElementById('chat-input');
        let lastTableData = null; // Store the last table data

        chatInput.addEventListener('keypress', function(event) {
            if (event.key === 'Enter') {
                sendMessage();
            }
        });

        function sendMessage() {
            const userMessage = chatInput.value;
            chatInput.value = '';
            appendMessage('User', userMessage);
            appendStatusMessage('Processing your request...');

            fetch('/get_response', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ message: userMessage })
            })
            .then(response => response.json())
            .then(data => {
                clearStatusMessage();
                appendMessage('AI', data.response);

                // Store the last table data if the response contains a table
                if (data.response.includes('<table')) {
                    lastTableData = extractTableData(data.response);
                }
            });
        }

        function appendMessage(sender, message) {
            const messageElement = document.createElement('div');
            messageElement.classList.add('message', sender);

            // Check if the message contains a table
            if (message.includes('<table')) {
                const tableContainer = document.createElement('div');
                tableContainer.classList.add('table-container');
                tableContainer.innerHTML = message;

                // Add export icon near the table
                const exportIcon = document.createElement('div');
                exportIcon.className = 'share-icon';
                exportIcon.innerHTML = '🔗 Export Table as CSV';
                exportIcon.onclick = () => exportTableToCSV(tableContainer.querySelector('table'));

                tableContainer.appendChild(exportIcon);
                messageElement.appendChild(tableContainer);
            } else {
                messageElement.innerHTML = `<strong>${sender}:</strong> ${message}`;
            }

            chatDisplay.appendChild(messageElement);
            chatDisplay.scrollTop = chatDisplay.scrollHeight;
        }

        function appendStatusMessage(message) {
            const statusElement = document.createElement('div');
            statusElement.classList.add('status');
            statusElement.innerText = message;
            chatDisplay.prepend(statusElement); // Add to the top
        }

        function clearStatusMessage() {
            const statusElements = document.querySelectorAll('.status');
            statusElements.forEach(el => el.remove());
        }

        function toggleColumns(table) {
            const columnsList = document.getElementById(`columns-${table}`);
            columnsList.style.display = columnsList.style.display === 'none' ? 'block' : 'none';
        }

        function exportTableToCSV(table) {
            if (!table) {
                alert("No table found to export.");
                return;
            }

            const rows = table.querySelectorAll('tr');
            const csv = [];

            // Loop through rows
            rows.forEach(row => {
                const rowData = [];
                const cols = row.querySelectorAll('th, td');

                // Loop through columns
                cols.forEach(col => {
                    rowData.push(col.innerText);
                });

                csv.push(rowData.join(','));
            });

            // Create CSV file
            const csvContent = "data:text/csv;charset=utf-8," + csv.join('\n');
            const encodedUri = encodeURI(csvContent);

            // Trigger download
            const link = document.createElement('a');
            link.setAttribute('href', encodedUri);
            link.setAttribute('download', 'table_data.csv');
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

        function openQueryOptimizer() {
            const modal = document.getElementById('query-optimizer-modal');
            modal.style.display = 'block'; // Show the modal
        }

        function closeQueryOptimizer() {
            const modal = document.getElementById('query-optimizer-modal');
            modal.style.display = 'none'; // Hide the modal
        }

        function optimizeQuery() {
            const query = document.getElementById('query-input').value;

            // Validate the query (ensure it's a SELECT statement)
            if (!query.trim().toLowerCase().startsWith('select')) {
                alert("Only SELECT queries are allowed for optimization.");
                return;
            }

            // Send the query to the backend for optimization
            fetch('/optimize_query', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ query: query }),
            })
            .then(response => response.json())
            .then(data => {
                if (data.error) {
                    alert(data.error);
                } else {
                    // Display the optimized query in the chat
                    appendMessage('AI', `Here’s an optimized version of your query:\n\n${data.optimized_query}`);
                    closeQueryOptimizer();
                }
            })
            .catch(error => {
                console.error('Error optimizing query:', error);
                alert("An error occurred while optimizing the query.");
            });
        }

        function extractTableData(html) {
            const parser = new DOMParser();
            const doc = parser.parseFromString(html, 'text/html');
            const table = doc.querySelector('table');
            if (!table) return null;

            const rows = table.querySelectorAll('tr');
            const data = [];

            // Loop through rows
            rows.forEach(row => {
                const rowData = [];
                const cols = row.querySelectorAll('th, td');

                // Loop through columns
                cols.forEach(col => {
                    rowData.push(col.innerText);
                });

                data.push(rowData);
            });

            return data;
        }

        function getInsights() {
            if (!lastTableData) {
                alert("No table data available for insights.");
                return;
            }

            appendStatusMessage('Generating insights...');

            // Send the last table data to the backend for insights
            fetch('/get_insights', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ table_data: lastTableData }),
            })
            .then(response => response.json())
            .then(data => {
                clearStatusMessage();
                appendMessage('AI', data.summary);
            })
            .catch(error => {
                console.error('Error fetching insights:', error);
                alert("An error occurred while generating insights.");
            });
        }
    </script>
</body>
</html>