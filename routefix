def generate_visualization(sql_query, plot_type):
    engine = create_engine(session.get('connection_string'))
    try:
        with engine.connect() as connection:
            df = pd.read_sql(sql_query, connection)
        
        if df.empty:
            return "The query returned no data for visualization."

        plt.figure(figsize=(10, 6))

        # Pie chart
        if "pie" in plot_type.lower():
            colors = sns.color_palette("viridis", len(df))
            plt.pie(df.iloc[:, 1], labels=df.iloc[:, 0], autopct='%1.1f%%', startangle=140, colors=colors)
            plt.title('Pie Chart')

        # Bar plot
        elif "bar" in plot_type.lower():
            sns.barplot(x=df.iloc[:, 0], y=df.iloc[:, 1], palette="viridis")
            plt.xticks(rotation=50, ha='right')
            plt.xlabel(df.columns[0])
            plt.ylabel(df.columns[1])
            plt.title('Bar Plot')
            plt.tight_layout()

        # Add more plot types if needed (e.g., line, scatter)
        elif "line" in plot_type.lower():
            sns.lineplot(x=df.iloc[:, 0], y=df.iloc[:, 1], marker="o", color="b")
            plt.title('Line Plot')
            plt.xlabel(df.columns[0])
            plt.ylabel(df.columns[1])
            plt.tight_layout()

        elif "scatter" in plot_type.lower():
            sns.scatterplot(x=df.iloc[:, 0], y=df.iloc[:, 1], color="r")
            plt.title('Scatter Plot')
            plt.xlabel(df.columns[0])
            plt.ylabel(df.columns[1])
            plt.tight_layout()

        else:
            return "Unsupported plot type."

        # Save the plot to a string buffer
        buffer = io.BytesIO()
        plt.savefig(buffer, format='png')
        buffer.seek(0)

        # Encode the image to base64 string
        img_str = base64.b64encode(buffer.getvalue()).decode()

        return f'<img src="data:image/png;base64,{img_str}" alt="Visualization"/>'

    except Exception as e:
        return f"Error generating visualization: {str(e)}"

def parse_natural_language_query(nl_query, schema_info, table_name):
    """
    Converts a natural language query into a SQL query compatible with the specified database type, 
    including support for Common Table Expressions (CTE).
    """
    # Get the database type, defaulting to 'mssql'
    db_type = session.get('db_type', 'mssql').lower()  
    if db_type not in ["mssql", "mysql", "postgresql"]:
        raise ValueError(f"Unsupported database type: {db_type}")

    # Get schema name from the session (relevant for PostgreSQL)
    schema_name = session.get('schema')  
    print("Session Data in parse_natural_language_query:", session)

    # Ensure valid schema name for PostgreSQL
    if db_type == "postgresql" and (not schema_name or not isinstance(schema_name, str)):
        raise ValueError("Schema name is not set or is invalid. Please log in again.")

    # Escape the table name and columns depending on database type
    escaped_table_name = escape_identifier(table_name, db_type)

    # Generate schema details (columns and relationships) dynamically
    schema_details = "\n".join(
        [f"Table {table}: {', '.join(info['columns'])}" for table, info in schema_info.items()]
    )
    
    # Handle relationships (if any) within the schema
    relationships = [
        f"Table {table}.{rel['foreign_column']} is related to Table {rel['primary_table']}.{rel['primary_column']}"
        for table, info in schema_info.items() for rel in info.get("relationships", [])
    ]
    if relationships:
        schema_details += "\n\nRelationships:\n" + "\n".join(relationships)

    # Define database-specific syntax for limits and ordering
    limit_syntax = "TOP 10" if db_type == "mssql" else "LIMIT 10"
    schema_prefix = f"{schema_name}." if db_type == "postgresql" else ""

    # Prepare database-specific examples
    db_specific_examples = f"""
        Examples:
        1. Natural language: How many rows are in the table?
           SQL: SELECT COUNT(*) FROM {schema_prefix}table_name;
        2. Natural language: Show all columns from the table.
           SQL: SELECT * FROM {schema_prefix}table_name;
        3. Natural language: Join table1 and table2 on column1.
           SQL: SELECT * FROM {schema_prefix}table1 
                INNER JOIN {schema_prefix}table2 ON table1.column1 = table2.column1;
        4. Natural language: Show the top 10 rows by column1.
           SQL: SELECT {limit_syntax} * FROM {schema_prefix}table_name ORDER BY column1;
        5. Natural language: Show the average of column1 grouped by column2.
           SQL: SELECT column2, AVG(column1) FROM {schema_prefix}table_name GROUP BY column2;
    """

    # Check if the query involves correlation, and adjust for MSSQL (or other databases)
    if "CORRELATION" in nl_query.upper():
        if db_type == "mssql":
            nl_query = nl_query.replace(
                "CORRELATION(column1, column2)", 
                "(SUM((column1 - AVG(column1)) * (column2 - AVG(column2))) / COUNT(*)) / (STDEV(column1) * STDEV(column2))"
            )
        else:
            nl_query = nl_query.replace("CORRELATION", "CORR")  # Standard for other DBs

    # Check if the query involves Common Table Expressions (CTE)
    if "WITH" in nl_query.upper():
        # Start of CTE manipulation
        # For simplicity, we assume any query mentioning 'WITH' wants to use CTEs.
        # We can wrap the query logic accordingly. For example:
        
        # Ensure proper format of CTE (assuming they are always with one result table)
        if db_type == "mssql":
            nl_query = nl_query.replace("WITH", f"WITH CTE_{escaped_table_name} AS ")
        elif db_type == "postgresql":
            nl_query = nl_query.replace("WITH", f"WITH CTE_{escaped_table_name} AS ")
        elif db_type == "mysql":
            nl_query = nl_query.replace("WITH", f"WITH CTE_{escaped_table_name} AS ")

    # Handle common SQL operations like GROUP BY, HAVING, ORDER BY, etc.
    if "GROUP BY" in nl_query.upper():
        # Ensure that the GROUP BY clause is handled correctly for all databases
        nl_query = nl_query.replace("GROUP BY", f"GROUP BY {schema_prefix}")
    
    if "HAVING" in nl_query.upper():
        # Ensure HAVING is used correctly in the SQL query
        nl_query = nl_query.replace("HAVING", f"HAVING {schema_prefix}")
    
    if "ORDER BY" in nl_query.upper():
        # Order by columns should be schema-qualified for PostgreSQL
        nl_query = nl_query.replace("ORDER BY", f"ORDER BY {schema_prefix}")

    # Construct the OpenAI prompt
    prompt = (
        f"You are a SQL expert specializing in {db_type}. "
        f"Convert the following natural language query into a {db_type}-compatible SQL query. "
        f"Schema details:\n{schema_details}\n\n"
        f"The table to query is {escaped_table_name} in the schema {schema_name}. "
        f"Always include the schema name in the SQL query if required. "
        f"If the query requires data from multiple tables, use JOINs to combine the data. "
        f"Query: {nl_query}\n\n"
        f"Examples of natural language to SQL conversion:\n"
        f"{db_specific_examples}"
    )

    # Call OpenAI GPT API to convert the query
    try:
        response = client.chat.completions.create(
            model="gpt-3.5-turbo",
            messages=[
                {"role": "system", "content": "You are a helpful assistant that converts natural language queries into SQL queries."},
                {"role": "user", "content": prompt}
            ]
        )
    except Exception as e:
        raise RuntimeError(f"Error communicating with OpenAI API: {e}")

    # Extract the SQL query from GPT response
    response_text = response.choices[0].message.content
    print("Response Text from OpenAI:", response_text)

    # Ensure schema name is included for PostgreSQL queries
    if db_type == "postgresql" and f"{schema_name}." not in response_text:
        response_text = response_text.replace("FROM ", f"FROM {schema_name}.")
        response_text = response_text.replace("JOIN ", f"JOIN {schema_name}.")

    # Use a helper function to extract the SQL query from the GPT response
    sql_query = extract_sql_query(response_text)
    return sql_query


def extract_sql_query(response_text):
    """
    Extract a SQL query from the response text.
    Supports SELECT queries and CTEs (WITH keyword).
    Handles triple backticks or other delimiters.
    """
    # Debugging: Print the input response text
    print("Response Text for SQL Extraction:", response_text)

    # Allow SELECT queries and CTEs
    keywords = ["WITH", "SELECT"]
    start = -1
    for keyword in keywords:
        start = response_text.upper().find(keyword)
        if start != -1:
            break
    if start == -1:
        print("No SQL query found in the response.")
        return None  # No SQL query found

    # Extract the SQL query portion from the response
    # Look for triple backticks (```) as delimiters
    end = response_text.find("```", start)
    if end == -1:
        # If no triple backticks, look for the end of the query (e.g., semicolon or end of string)
        end = response_text.find(";", start)
        if end == -1:
            end = len(response_text)

    # Extract the query and clean it up
    sql_query = response_text[start:end].strip()

    # Debugging: Print the extracted SQL query
    print("Extracted SQL Query:", sql_query)

    # Ensure the query starts with either SELECT or WITH
    if not (sql_query.upper().startswith("SELECT") or sql_query.upper().startswith("WITH")):
        print("Extracted query is not a SELECT query or does not use WITH.")
        return None

    return sql_query
def adjust_query_for_db_type(sql_query, db_type):
    """
    Adjusts the SQL query for database compatibility.
    """
    print(f"Original SQL query: {sql_query}")
    
    if db_type == "mssql":
        # Replace CORR with manual formula for MSSQL
        sql_query = re.sub(
            r"CORR\((\w+),\s*(\w+)\)", 
            r"""(
                (COUNT(*) * SUM(\1 * \2) - SUM(\1) * SUM(\2)) 
                / 
                (SQRT((COUNT(*) * SUM(POWER(\1, 2)) - POWER(SUM(\1), 2)) * 
                      (COUNT(*) * SUM(POWER(\2, 2)) - POWER(SUM(\2), 2))))
            )""",
            sql_query
        )
        print(f"SQL after CORR replacement: {sql_query}")

        # Replace LIMIT with TOP for MSSQL
        sql_query = re.sub(r"LIMIT\s+(\d+)", r"TOP \1", sql_query)
        print(f"SQL after LIMIT replacement: {sql_query}")
    
    elif db_type == "postgresql":
        # Replace TOP with LIMIT for PostgreSQL
        sql_query = re.sub(r"TOP\s+(\d+)", r"LIMIT \1", sql_query)
        print(f"SQL after TOP replacement: {sql_query}")
    
    elif db_type == "mysql":
        # Replace MSSQL-specific functions or syntax with MySQL equivalents
        sql_query = sql_query.replace("GETDATE()", "NOW()")
        print(f"SQL after MySQL replacement: {sql_query}")
    
    # Add more database-specific adjustments as needed
    print(f"Final adjusted SQL query: {sql_query}")
    return sql_query
def process_cte_query(nl_query, escaped_table_name, db_type):
    """
    Adjusts the CTE part of the query dynamically based on the database type.
    
    Parameters:
        nl_query (str): The natural language SQL query.
        escaped_table_name (str): The sanitized/escaped table name.
        db_type (str): The type of the database (e.g., 'mssql', 'postgresql', 'mysql').

    Returns:
        str: Modified SQL query with appropriate CTE handling.
    """
    # Check if the query mentions 'WITH' for potential CTE usage
    if "WITH" in nl_query.upper():
        # Sanitize escaped table name for safety
        escaped_table_name = escaped_table_name.replace(" ", "_").replace("-", "_")

        # Add CTE-specific handling
        if db_type in ["mssql", "postgresql", "mysql"]:
            # Add a CTE prefix dynamically to avoid naming conflicts
            cte_name = f"CTE_{escaped_table_name}"
            nl_query = nl_query.replace("WITH", f"WITH {cte_name} AS ", 1)  # Replace only the first occurrence
        else:
            raise ValueError(f"Unsupported database type: {db_type}")
    
    return nl_query

