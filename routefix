def generate_dynamic_prompts(df):
    """Generate and prioritize dynamic prompts based on the table's structure."""
    prompts = []
    priorities = []

    # Identify column types
    numeric_columns = df.select_dtypes(include=['number']).columns.tolist()
    datetime_columns = df.select_dtypes(include=['datetime']).columns.tolist()
    categorical_columns = df.select_dtypes(include=['object', 'category']).columns.tolist()

    # Helper function to assign priority
    def add_prompt(prompt, priority):
        prompts.append((prompt, priority))

    # Descriptive Insights (High Priority)
    for col in numeric_columns:
        add_prompt(f"What is the average {col}?", 1)
        add_prompt(f"What is the total {col}?", 1)
        if datetime_columns:
            add_prompt(f"How has {col} changed over {datetime_columns[0]}?", 1)

    # Diagnostic Insights (Medium Priority)
    if len(numeric_columns) > 1:
        for i, col1 in enumerate(numeric_columns):
            for col2 in numeric_columns[i+1:]:
                add_prompt(f"Is there a relatioship between {col1} and {col2}?", 2)

    # Predictive Insights (Medium Priority)
    if numeric_columns and datetime_columns:
        for col in numeric_columns:
            add_prompt(f"Can we predict future trends of {col} using {datetime_columns[0]}?", 2)

    # Exploratory Insights (Low Priority)
    for col in categorical_columns:
        add_prompt(f"What are the unique values in {col}?", 3)
        add_prompt(f"Show a distribution of rows by {col}.", 3)
        if numeric_columns:
            add_prompt(f"What is the total {numeric_columns[0]} by {col}?", 3)

    # Handle fallback cases
    if not prompts:
        add_prompt("Show the first 10 rows of this table.", 4)

    # Sort prompts by priority
    prompts = sorted(prompts, key=lambda x: x[1])  # Sort by priority (lower is higher priority)

    # Extract prompt text only for return
    return [prompt[0] for prompt in prompts]



def escape_identifier(identifier, db_type):
    """Escape table/column names based on the database type."""
    if db_type == "mysql":
        return f"`{identifier}`"
    elif db_type == "postgresql":
        return f'"{identifier}"'
    else:
        return identifier  # Default to no escaping for other databases

def generate_sql_query(table_name, columns, db_type):
    """Generate a SQL query with escaped table/column names."""
    escaped_table = escape_identifier(table_name, db_type)
    escaped_columns = [escape_identifier(col, db_type) for col in columns]
    columns_str = ", ".join(escaped_columns)
    return f"SELECT {columns_str} FROM {escaped_table};"

def execute_query_with_retry(query, db_type, engine):
    """Execute a SQL query and retry with escaped names if it fails."""
    try:
        # Try executing the query
        with engine.connect() as connection:
            result = connection.execute(text(query))
            return result
    except (OperationalError, ProgrammingError) as e:
        # Analyze the error message
        error_message = str(e)
        if "Unknown column" in error_message:
            # Handle unknown column errors
            column_name = re.search(r"Unknown column '(.+?)'", error_message).group(1)
            return f"Error: The column '{column_name}' does not exist."
        elif "Table doesn't exist" in error_message or "relation does not exist" in error_message:
            # Handle table name errors
            table_name = re.search(r"Table '(.+?)'", error_message).group(1)
            escaped_table = escape_identifier(table_name, db_type)
            retry_query = query.replace(table_name, escaped_table)
            return execute_query_with_retry(retry_query, db_type, engine)
        else:
            return "❌ Hmm, I couldn't process that query. 🛠️ Maybe try rephrasing it? 😊"
