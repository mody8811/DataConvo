# ============================================================
# Data Convo — Self-Hosted Production Environment Template
# Copy this file to `.env` and fill in each value.
#     cp .env.example .env
# ============================================================

# ------------------------------------------------------------
# Application secrets (MUST CHANGE for production)
# ------------------------------------------------------------
# Flask session/secret key — generate one with:
#     python -c "import secrets; print(secrets.token_hex(32))"
# Accepted env names: FLASK_SECRET_KEY (preferred) or SECRET_KEY (legacy).
FLASK_SECRET_KEY=change-me-to-a-long-random-hex-string

# HMAC license-signing secret. This MUST match the secret used by your
# internal license generator (generate_key.py — LICENSE_SIGNING_SECRET).
# Keys signed with a different secret will be rejected on activation.
# Generate with:
#     python -c "import secrets; print(secrets.token_hex(32))"
LICENSE_SIGNING_SECRET=change-me-to-a-long-random-hex-string

# ------------------------------------------------------------
# Server / port
# ------------------------------------------------------------
# Port the app binds to inside the container & exposed on the host.
# docker-compose uses this to publish the port.
PORT=8000

# ------------------------------------------------------------
# Database (default: local SQLite inside the named volume)
# ------------------------------------------------------------
# docker-compose.yml already forces SQLite to /app/data/dataconvo.db
# (a named volume) so users/workspaces/semantic models persist across
# `docker compose pull && docker compose up -d`.
#
# For PostgreSQL/Supabase, uncomment and set:
# DATABASE_URL=postgresql://user:password@host:5432/dataconvo

# ------------------------------------------------------------
# LLM provider — BYOK (Bring Your Own Key) is REQUIRED. There is NO
# platform API key fallback in self-hosted mode.
# ------------------------------------------------------------
# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here
# OpenRouter (optional alternative provider)
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Anthropic (optional alternative provider)
# ANTHROPIC_API_KEY=

# ------------------------------------------------------------
# Auth backends (ALL optional — local email/password always works)
# ------------------------------------------------------------
# Supabase Auth (email/password)
# https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Google OAuth (Sign in with Google)
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------
# Stripe (subscription billing — Team tier payment link)
# ------------------------------------------------------------
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe Price ID for the Pro tier (legacy checkout)
STRIPE_PRO_PRICE_ID=price_xxxxxxxxxxxxxxxx
# Stripe Payment Link for the Team/Pro tier ($399/month) — shown on /pricing
# https://buy.stripe.com/dRmfZh1ti2lF8oCgnK0x200
STRIPE_TEAM_PAYMENT_LINK=https://buy.stripe.com/dRmfZh1ti2lF8oCgnK0x200

# ------------------------------------------------------------
# In-app version checker (optional)
# ------------------------------------------------------------
# Remote JSON feed with {"version": "1.1.0"} for the update banner.
VERSION_CHECK_URL=
# Deployed release version shown in the UI.
APP_VERSION=1.0.0

# ------------------------------------------------------------
# Email / SMTP (workspace invitations)
# ------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=support@dataconvo.app

# ------------------------------------------------------------
# Site URL & feature flags
# ------------------------------------------------------------
# Public site URL (used for invite links / OpenRouter referer).
SITE_URL=http://localhost:8000
# Enable legacy pre-flight intent classifier (~5s latency). Default off.
ENABLE_QUERY_CLASSIFIER=false