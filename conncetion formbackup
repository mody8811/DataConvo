<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="{{ url_for('static', filename='style.css') }}">
    <title>Database Connection</title>
    <script>
        function toggleAuthFields() {
            const authType = document.getElementById('auth_type').value;
            const userPassFields = document.getElementById('user-pass-fields');

            if (authType === 'sql') {
                userPassFields.style.display = 'block';
            } else {
                userPassFields.style.display = 'none';
            }
        }

        document.addEventListener('DOMContentLoaded', (event) => {
            toggleAuthFields();  // Initial call to set the correct fields visibility
        });
    </script>
</head>
<body>
    <h1>Enter Database Connection Details</h1>
    <form action="{{ url_for('main.set_connection') }}" method="post">
        <label for="db_type">Database Type:</label>
        <select name="db_type" id="db_type" required>
            <option value="mssql">SQL Server</option>
            <option value="mysql">MySQL</option>
            <option value="postgresql">PostgreSQL</option>
            <option value="azure_sql">Azure SQL</option>
            <option value="aws_rds">AWS RDS</option>
            <option value="google_sql">Google SQL</option>
        </select>
        <br>
        <label for="server">Server:</label>
        <input type="text" name="server" id="server" required>
        <br>
        <label for="database">Database:</label>
        <input type="text" name="database" id="database" required>
        <br>
        <label for="schema">Schema:</label>
        <input type="text" name="schema" id="schema" required>
        <br>
        <label for="auth_type">Authentication Type:</label>
        <select name="auth_type" id="auth_type" onchange="toggleAuthFields()" required>
            <option value="windows">Windows Authentication</option>
            <option value="sql">Database Authentication</option>
        </select>
        <div id="user-pass-fields" style="display: none;">
            <br>
            <label for="username">Username:</label>
            <input type="text" name="username" id="username">
            <br>
            <label for="password">Password:</label>
            <input type="password" name="password" id="password">
        </div>
        <br>
        <button type="submit">Connect</button>
    </form>
</body>
</html>
